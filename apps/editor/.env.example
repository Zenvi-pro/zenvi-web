# Copy to .env.local (gitignored) and fill in. Every value here is public:
# Vite inlines VITE_* variables into the browser bundle.

# Supabase project shared with zenvi.pro (public anon/publishable key).
# Leave empty to run the editor signed-out only.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Zenvi backend (Assistant). The chat WebSocket connects here directly;
# REST calls go through the same-origin proxy /editor/api/zenvi/* (Vite dev
# proxy locally, vercel.json rewrite in production).
VITE_ZENVI_BACKEND_URL=https://api.zenvi.pro

# Zenvi Cloud (projects, media, renders). Leave empty to disable cloud features.
VITE_ZENVI_CLOUD_URL=https://zenvi-cloud.whitesky-da3c8402.eastus.azurecontainerapps.io

# OAuth (GitHub/Google). Under zenvi.pro the editor returns through the
# website's /auth/callback (in Supabase's redirect allowlist), with the editor
# path as ?next=. Set this for other website origins (e.g. previews): an
# absolute URL used when it matches the page's origin, or a path such as
# /auth/callback on whatever origin serves the editor.
VITE_ZENVI_WEBSITE_CALLBACK=

# Show GitHub/Google buttons on origins without the website callback
# (zenvi-editor.vercel.app, localhost) — only if Supabase allows
# <origin>/editor/login as a redirect. Email and password always work.
VITE_ENABLE_OAUTH=
