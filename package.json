{
  "name": "zenvi-web",
  "private": true,
  "type": "module",
  "description": "Zenvi engine, web editor, CLI, MCP servers and cloud service",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "dev:editor": "npm run dev -w @zenvi/editor",
    "zenvi": "tsx packages/cli/src/bin.ts",
    "acceptance": "tsx packages/cli/src/acceptance/main.ts",
    "tool-truth": "tsx packages/render-node/scripts/tool-truth.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
