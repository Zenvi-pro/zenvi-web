{
  "//": "Type-checks the After Effects host scripts against types-for-adobe AfterEffects/26.0 (ES3 lib, no DOM): npm run typecheck:jsx",
  "compilerOptions": {
    "target": "ES5",
    "noLib": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": false,
    "noImplicitAny": false,
    "noErrorTruncation": true,
    "types": ["types-for-adobe/AfterEffects/26.0"]
  },
  "files": ["types/aeft-host.d.ts"],
  "include": ["extension/host/aeft/*.jsx"]
}
